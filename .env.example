# Backend API URL
# Example for local development: http://localhost:8001
# Example for Docker: http://backend:8001
# Example for production: https://api.yourapp.com
VITE_BACKEND_URL=

# Arena Backend API URL
# Example for local development: http://localhost:8003
# Example for Docker: http://arena-backend:8003
# Example for production: https://arena-api.yourapp.com
VITE_ARENA_BACKEND_URL=

# WebSocket URL for real-time notifications
# Example for local development: ws://localhost:8008/ws/notifications
# Example for Docker: ws://worker-service:8008/ws/notifications
# Example for production: wss://worker-api.yourapp.com/ws/notifications
VITE_WS_URL=
